#!/bin/bash

# 1. Give the menu time to close completely
sleep 0.4

# 2. Force creation of the target folder using an absolute home path
TARGET_DIR="$HOME/Imágenes/Screenshots"
mkdir -p "$TARGET_DIR"

# 3. Generate a safe, unique filename
FILE_NAME="Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
TARGET="$TARGET_DIR/$FILE_NAME"

# 4. Choose mode based on argument
if [ "$1" = "region" ]; then
    GEOM=$(slurp) || exit 1
    grim -g "$GEOM" "$TARGET"
else
    grim "$TARGET"
fi

# 5. Fallback verification: Check if the file actually exists on your drive
if [ -f "$TARGET" ]; then
    # Copy file to clipboard
    wl-copy < "$TARGET"
    # Send notification with image preview
    notify-send -i "$TARGET" "Screenshot Captured" "Saved to $TARGET_DIR"
else
    # If grim failed to create a file, fallback to clipboard only
    grim - | wl-copy
    notify-send "Screenshot Error" "Could not save file to disk, copied to clipboard instead."
fi

